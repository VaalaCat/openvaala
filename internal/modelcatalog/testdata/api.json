{
  "compat": {
    "id": "compat",
    "name": "Compat Gateway",
    "npm": "@ai-sdk/openai-compatible",
    "api": "https://compat.example/v1",
    "env": [
      "COMPAT_API_KEY"
    ],
    "models": {
      "plain": {
        "id": "plain",
        "name": "Plain Model",
        "reasoning": false,
        "modalities": {
          "input": [
            "text"
          ],
          "output": [
            "text"
          ]
        },
        "limit": {
          "context": 128000,
          "output": 8192
        }
      },
      "think-medium": {
        "id": "think-medium",
        "name": "Think Medium",
        "reasoning": true,
        "modalities": {
          "input": [
            "text",
            "image",
            "pdf"
          ],
          "output": [
            "text"
          ]
        },
        "reasoning_options": [
          {
            "type": "toggle"
          },
          {
            "type": "effort",
            "values": [
              "minimal",
              "low",
              "medium",
              "high"
            ]
          }
        ],
        "limit": {
          "context": 200000,
          "output": 64000,
          "input": 150000
        }
      },
      "think-no-medium": {
        "id": "think-no-medium",
        "name": "Think No Medium",
        "reasoning": true,
        "reasoning_options": [
          {
            "type": "budget_tokens",
            "min": 1024,
            "max": 32000
          },
          {
            "type": "effort",
            "values": [
              "low",
              null,
              "high",
              "max"
            ]
          }
        ],
        "limit": {
          "context": 256000,
          "output": 32000
        }
      },
      "only-null-efforts": {
        "id": "only-null-efforts",
        "name": "Only Null Efforts",
        "reasoning": true,
        "reasoning_options": [
          {
            "type": "effort",
            "values": [
              null
            ]
          }
        ],
        "limit": {
          "context": 64000,
          "output": 4096
        }
      },
      "no-limit": {
        "id": "no-limit",
        "name": "No Limit",
        "reasoning": false
      },
      "a/b:c": {
        "id": "a/b:c",
        "name": "Slash Colon",
        "reasoning": false,
        "limit": {
          "context": 1000,
          "output": 100
        }
      },
      "a:b:c": {
        "id": "a:b:c",
        "name": "Colon Colon",
        "reasoning": false,
        "limit": {
          "context": 2000,
          "output": 200
        }
      },
      "claude-style": {
        "id": "claude-style",
        "name": "Claude Style",
        "reasoning": false,
        "provider": {
          "npm": "@ai-sdk/anthropic"
        },
        "limit": {
          "context": 300000,
          "output": 16000
        }
      },
      "same-sdk": {
        "id": "same-sdk",
        "name": "Same SDK",
        "reasoning": false,
        "modalities": {
          "input": [
            "image",
            "hologram",
            "text"
          ],
          "output": [
            "text"
          ]
        },
        "provider": {
          "npm": "@ai-sdk/openai-compatible"
        },
        "limit": {
          "context": 4000,
          "output": 400
        }
      },
      "unknown-sdk": {
        "id": "unknown-sdk",
        "name": "Unknown SDK",
        "reasoning": false,
        "provider": {
          "npm": "@ai-sdk/google"
        },
        "limit": {
          "context": 5000,
          "output": 500
        }
      }
    }
  },
  "openai": {
    "id": "openai",
    "name": "OpenAI",
    "npm": "@ai-sdk/openai",
