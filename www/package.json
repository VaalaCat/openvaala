{
  "name": "openvaala-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src e2e vite.config.ts playwright.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "pnpm build && playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "generate:types": "go run ../internal/protocolgen src/lib/api/protocol.gen.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/react": "2.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "ansi-to-react": "6.2.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "i18next": "26.5.11",
    "lucide": "1.62.0",
    "lucide-react": "1.62.0",
    "morphicons": "2.0.2",
    "motion": "14.9.0",
    "nanostores": "1.5.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-resizable-panels": "4.15.0",
    "react-router": "8.5.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
}
